{
  "mcpServers": {
    "pigeon-mail": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "--env",
        "PIGEON_DB_PATH=/var/lib/pigeon/pigeon.db",
        "--env",
        "PIGEON_MASTER_KEY_FILE=/etc/pigeon/master.key",
        "pigeon-mail",
        "/usr/local/bin/pigeon",
        "mcp"
      ]
    }
  }
}
