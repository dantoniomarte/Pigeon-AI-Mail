# Pigeon Mail — environment reference.
#
# Copy to `.env` and adjust. Compose reads `.env` (see docker-compose.yml);
# the systemd installer writes its own copy to /etc/pigeon/pigeon.env.
#
# NO SECRETS IN THIS FILE. The master key is a *file* (PIGEON_MASTER_KEY_FILE)
# holding 32 bytes of entropy, owned root:pigeon with mode 0640. It is never
# passed as an environment variable value.
#
# Source of truth for every variable: docs/ARCHITECTURE.md ->
# "Configuration (principal env vars)". Everything is 12-factor: env only,
# no config file.

# API + MCP-over-HTTP listen address. Put a TLS terminator in front of it.
PIGEON_HTTP_ADDR=:8000

# Inbound SMTP (port 25). Submission on 587 uses the same listener family.
# See docs/DEPLOY.md for the ":25 must be free" warning.
PIGEON_SMTP_IN_ADDR=:25

# SQLite database file. Must live on real disk (never tmpfs) — ADR 0002.
PIGEON_DB_PATH=/var/lib/pigeon/pigeon.db

# 32-byte master key file, hex-encoded (64 chars). Losing it means losing every
# stored message: back it up together with the database.
PIGEON_MASTER_KEY_FILE=/etc/pigeon/master.key

# Outbound STARTTLS policy: required | pinned | opportunistic
# `required` refuses plaintext delivery to remote MX servers (ADR 0003).
PIGEON_SMTP_OUT_STARTTLS=required

# Serve the bundled webmail: off | on
# `on`/`off` is the documented spelling — install.sh, the Kubernetes ConfigMap
# and this file all use it; the parser also accepts `true` and `1`. The webmail
# bundle is optional: the API and SMTP paths work without it.
PIGEON_WEBMAIL=off

# --- Compose build knobs (read by `docker compose`, never by the server) ------
# Shipping the webmail bundle needs BOTH: WEBMAIL_TARGET selects the Dockerfile
# target (the only path to the Node stage) and WITH_WEBMAIL=1 is what that stage
# builds. Leave both out for the binary-only image: no target is rendered and
# node:22-slim is never pulled.
# WEBMAIL_TARGET=pigeon-webmail
# WITH_WEBMAIL=1

# tracing filter; `json` opts into structured logs.
PIGEON_LOG=info,json
